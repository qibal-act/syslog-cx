# Docker Compose settings for the TAP Syslog collector (NON-SECRET only).
# Copy to .env, edit the values, then:
#   docker compose --env-file .env up -d
#
# CORALOGIX_KEY_FILE is a host path to a file that contains only the
# Send-Your-Data API key (one line). The key itself is never stored here.
# chmod 600 that file.

# Ingress domain for your region, e.g. ap3.coralogix.com
CORALOGIX_DOMAIN=replace-region.coralogix.com
# Absolute host path to the Send-Your-Data API key file.
CORALOGIX_KEY_FILE=/absolute/path/to/coralogix-send-data-key

# FortiGate 400F listener: host UDP -> collector UDP 5514, RFC5424
FORTIGATE_SYSLOG_UDP_PORT=5514
CORALOGIX_FORTIGATE_APPLICATION=fortigate
CORALOGIX_FORTIGATE_SUBSYSTEM=firewall

# Ruckus SmartZone AP listener: host UDP -> collector UDP 5515, RFC3164 (BSD)
RUCKUS_SYSLOG_UDP_PORT=5515
CORALOGIX_RUCKUS_APPLICATION=ruckus
CORALOGIX_RUCKUS_SUBSYSTEM=wireless

# MikroTik listener: host UDP -> collector UDP 5516, RFC3164 (BSD, UDP-only)
MIKROTIK_SYSLOG_UDP_PORT=5516
CORALOGIX_MIKROTIK_APPLICATION=mikrotik
CORALOGIX_MIKROTIK_SUBSYSTEM=routeros
